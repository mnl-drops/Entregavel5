{
  "name": "sistema-vendas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de vendas com React, Express, SQLite e JWT",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=src src/server.js",
    "dev:web": "npm --prefix frontend run dev",
    "start": "node src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0"
  }
}
